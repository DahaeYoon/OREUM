        <item name="colorTertiary">@color/oreum_yellow_accent</item>
        <item name="android:colorBackground">@color/oreum_cream_white</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/oreum_dark_text</item>
        <item name="colorOnBackground">@color/oreum_dark_text</item>
        <item name="android:windowLightStatusBar">true</item>
