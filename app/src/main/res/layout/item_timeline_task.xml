<?xml version="1.0" encoding="utf-8"?>
<!-- 타임라인 항목: 체크 동그라미 · (아래로 잇는 선) · 이름 · 목표 이름 · 시간 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- 다음 항목으로 잇는 선 (마지막 항목은 숨김) -->
    <View
        android:id="@+id/line"
        android:layout_width="2dp"
        android:layout_height="match_parent"
        android:layout_marginStart="10dp"
        android:layout_marginTop="32dp"
        android:background="#141F2D2A" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="10dp">

        <FrameLayout
            android:id="@+id/btn_check"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="@drawable/bg_check_off">

            <ImageView
                android:id="@+id/icon_check"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_check"
                android:visibility="gone"
                app:tint="@color/white" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/item"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.1"
                android:textColor="@color/oreum_dark_text"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="동시성 제어 · 락 정리" />

            <TextView
                android:id="@+id/text_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/oreum_ink3"
                android:textSize="11sp"
                tools:text="데이터베이스 기말고사" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_minutes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textColor="@color/oreum_ink2"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="2시간" />
    </LinearLayout>
</FrameLayout>
