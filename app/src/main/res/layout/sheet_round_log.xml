<?xml version="1.0" encoding="utf-8"?>
<!-- 구간 학습 결과 기록 (프로토타입 roundLogSheet · 1차)
     요약(오늘 · 누적 / 예상 · 완료 수) · 미완료 경고 한 줄 · 항목별 체크/오늘 시간/못 끝낸 이유 · 체감 난이도 · 한 줄 메모 · 오늘 기록 저장 / 구간 결과 제출 -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="22dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_grab" />

        <TextView
            android:id="@+id/text_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/oreum_dark_text"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="4구간 학습 결과 기록" />

        <TextView
            android:id="@+id/text_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/oreum_ink2"
            android:textSize="11.5sp"
            tools:text="데이터베이스 기말고사 · 오늘(11/5) 공부한 시간을 맞추고, 구간을 마치면 결과를 제출해요" />

        <!-- 요약 + 미완료 경고 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:background="@drawable/bg_log_sum"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/text_sum"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/oreum_ink2"
                    android:textSize="12sp"
                    tools:text="오늘 20분 · 이 구간 누적 20분 / 예상 1시간 50분" />

                <TextView
                    android:id="@+id/text_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textColor="@color/oreum_dark_text"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="1/4" />
            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:max="100"
                app:indicatorColor="@color/oreum_forest_mint"
                app:trackColor="#CCFFFFFF"
                app:trackCornerRadius="3dp"
                app:trackStopIndicatorSize="0dp"
                app:trackThickness="5dp" />

            <LinearLayout
                android:id="@+id/box_miss"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_warn"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_marginTop="1dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_alert"
                    app:tint="#C0533A" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/text_miss"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#C0533A"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="3개를 못 끝냈어요" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="@string/round_log_miss_body"
                        android:textColor="@color/oreum_ink2"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 항목별 (코드에서 item_log_row로 채움) -->
        <LinearLayout
            android:id="@+id/row_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="vertical" />

        <!-- 체감 난이도 -->
        <LinearLayout
            android:id="@+id/row_diff_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/round_log_diff"
                android:textColor="@color/oreum_ink2"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/round_log_diff_opt"
                android:textColor="@color/oreum_ink3"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/seg_diff"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_seg_track_glass"
            android:orientation="horizontal"
            android:padding="3dp">

            <TextView
                style="@style/Widget.OREUM.SegItem"
                tools:text="쉬움" />

            <TextView
                style="@style/Widget.OREUM.SegItem"
                tools:text="적당" />

            <TextView
                style="@style/Widget.OREUM.SegItem"
                tools:text="어려움" />
        </LinearLayout>

        <EditText
            android:id="@+id/input_memo"
            style="@style/Widget.OREUM.Input.Glass"
            android:layout_height="38dp"
            android:layout_marginTop="12dp"
            android:hint="@string/round_log_memo_hint"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLength="80"
            android:paddingHorizontal="12dp"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/round_log_note"
            android:textColor="@color/oreum_ink3"
            android:textSize="11.5sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save"
                style="@style/Widget.OREUM.Button.SheetOutline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/round_log_save" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_submit"
                style="@style/Widget.OREUM.Button.SheetPrimary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1.3"
                android:text="@string/round_log_submit"
                app:icon="@drawable/ic_check"
                app:iconGravity="textStart"
                app:iconPadding="4dp"
                app:iconSize="16dp"
                app:iconTint="@color/white" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
