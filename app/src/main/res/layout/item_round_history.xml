<?xml version="1.0" encoding="utf-8"?>
<!-- 이전 구간 한 줄: 구간 번호 · 주제 · 날짜 · 완료 표시 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="11dp">

    <TextView
        android:id="@+id/text_no"
        android:layout_width="wrap_content"
        android:minWidth="44dp"
        android:layout_height="wrap_content"
        android:minHeight="44dp"
        android:paddingHorizontal="6dp"
        android:background="@drawable/bg_round_badge_done"
        android:gravity="center"
        android:lineSpacingMultiplier="0.9"
        android:textColor="#2E7A5F"
        android:textSize="15sp"
        android:textStyle="bold"
        tools:text="3구간" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_topic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/oreum_dark_text"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="함수 종속 · 1~3 정규형" />

        <TextView
            android:id="@+id/text_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/oreum_ink3"
            android:textSize="12sp"
            tools:text="11/3 ~ 11/4 · 2일" />
    </LinearLayout>

    <TextView
        android:id="@+id/text_done"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_badge"
        android:paddingHorizontal="9dp"
        android:paddingVertical="3dp"
        android:textColor="#2E7A5F"
        android:textSize="12sp"
        android:textStyle="bold"
        tools:text="3/5" />
</LinearLayout>
