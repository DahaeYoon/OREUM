<?xml version="1.0" encoding="utf-8"?>
<!-- 학습 항목 추가 · 수정 팝업 (프로토타입 itemForm): 이름 · 목표 · 날짜 · 예상 소요시간 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="10dp"
    android:paddingBottom="22dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_grab" />

    <TextView
        android:id="@+id/text_sheet_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="@color/oreum_dark_text"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:text="@string/item_title_add" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/item_label_title"
        android:textAppearance="@style/TextAppearance.OREUM.FormLabel" />

    <EditText
        android:id="@+id/input_title"
        style="@style/Widget.OREUM.Input.Glass"
        android:layout_marginTop="6dp"
        android:hint="@string/item_hint_title"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLength="40" />

    <TextView
        android:id="@+id/text_title_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/item_error_title"
        android:textColor="@color/oreum_error"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/group_goal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/task_label_goal"
            android:textAppearance="@style/TextAppearance.OREUM.FormLabel" />

        <Spinner
            android:id="@+id/spinner_goal"
            style="@style/Widget.OREUM.Input.Glass"
            android:layout_marginTop="6dp"
            android:paddingStart="6dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/task_label_date"
                android:textAppearance="@style/TextAppearance.OREUM.FormLabel" />

            <TextView
                android:id="@+id/btn_date"
                style="@style/Widget.OREUM.Input.Glass"
                android:layout_marginTop="6dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:textSize="14sp"
                app:drawableEndCompat="@drawable/ic_nav_calendar"
                app:drawableTint="@color/oreum_dark_text"
                tools:text="2026.11.12" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/task_label_minutes"
                android:textAppearance="@style/TextAppearance.OREUM.FormLabel" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_glass"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_minus"
                    android:layout_width="40dp"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/item_minus"
                    android:gravity="center"
                    android:text="−"
                    android:textColor="@color/oreum_dark_text"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/text_minutes"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="@color/oreum_dark_text"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="30분" />

                <TextView
                    android:id="@+id/btn_plus"
                    android:layout_width="40dp"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/item_plus"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="@color/oreum_dark_text"
                    android:textSize="17sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_delete"
            style="@style/Widget.OREUM.Button.SheetOutline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:text="@string/study_detail_delete"
            android:textColor="@color/oreum_coral_ink"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel"
            style="@style/Widget.OREUM.Button.SheetOutline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/study_form_cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save"
            style="@style/Widget.OREUM.Button.SheetPrimary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1.4"
            android:text="@string/study_form_save_edit" />
    </LinearLayout>
</LinearLayout>
