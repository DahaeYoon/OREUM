<?xml version="1.0" encoding="utf-8"?>
<!-- 구간 항목 한 줄: 완료 체크 · 이름 · (이어서/복습) · 예상 시간 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal">

    <FrameLayout
        android:id="@+id/btn_check"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="-8dp"
        android:background="?attr/selectableItemBackgroundBorderless">

        <FrameLayout
            android:id="@+id/check_box"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_check_off">

            <ImageView
                android:id="@+id/icon_check"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_check"
                android:visibility="gone"
                app:tint="@android:color/white" />
        </FrameLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/row_main"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="44dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/text_kind"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_round_kind"
            android:paddingHorizontal="6dp"
            android:paddingVertical="1dp"
            android:textColor="#3A6EA8"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="이어서"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/text_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/oreum_dark_text"
            android:textSize="14sp"
            tools:text="개념 학습: BCNF와 반정규화" />

        <TextView
            android:id="@+id/text_minutes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/oreum_ink3"
            android:textSize="12.5sp"
            tools:text="45분" />
    </LinearLayout>
</LinearLayout>
