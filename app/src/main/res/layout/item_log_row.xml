<?xml version="1.0" encoding="utf-8"?>
<!-- 학습 결과 기록의 항목 하나: 체크 · 이름/계획 시간 · 실제 시간(−/+) · (못 끝냈으면) 이유 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:background="@drawable/bg_log_row"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/btn_check"
            android:layout_width="26dp"
            android:layout_height="26dp">

            <FrameLayout
                android:id="@+id/box"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_check_off">

                <ImageView
                    android:id="@+id/icon_check"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_check"
                    android:visibility="gone"
                    app:tint="@color/white" />
            </FrameLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/text_title"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:layout_height="wrap_content"
            android:textColor="@color/oreum_dark_text"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="인덱스 · B+트리 정리" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/text_planned"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textColor="@color/oreum_ink2"
            android:textSize="12sp"
            tools:text="예상 소요시간: 25분" />


        <LinearLayout
            android:layout_width="142dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_stepper"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_minus"
                android:layout_width="36dp"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/item_minus"
                android:gravity="center"
                android:text="−"
                android:textColor="@color/oreum_dark_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/text_minutes"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:layout_weight="1"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/oreum_dark_text"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="1시간 30분" />

            <TextView
                android:id="@+id/btn_plus"
                android:layout_width="36dp"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/item_plus"
                android:gravity="center"
                android:text="+"
                android:textColor="@color/oreum_dark_text"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/group_reason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/log_reason_label"
            android:textColor="@color/oreum_ink2"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/group_reasons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            app:chipSpacingHorizontal="4dp"
            app:chipSpacingVertical="4dp" />
    </LinearLayout>
</LinearLayout>
