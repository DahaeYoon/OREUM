<?xml version="1.0" encoding="utf-8"?>
<!-- 홈 카드 전환 (산 · 오늘 계획): 흰 반투명 알약 안의 작은 칸 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="30dp"
    android:background="@drawable/bg_home_ind"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="3dp">

    <TextView
        android:id="@+id/ind_item_mountain"
        style="@style/Widget.OREUM.HomeIndItem"
        android:text="@string/home_page_mountain" />

    <TextView
        android:id="@+id/ind_item_today"
        style="@style/Widget.OREUM.HomeIndItem"
        android:layout_marginStart="2dp"
        android:text="@string/home_page_today" />
</LinearLayout>
