<?xml version="1.0" encoding="utf-8"?>
<!-- AI 다음 구간 추천 (프로토타입 08 · 시뮬레이션): 산 배경 위 유리 팝업
     목표 · n구간 추천이 준비됐어요 / 단계 · 주제 · 할 일 · 예상 시간 / 지난 구간 한 줄 / 이렇게 바꿨어요 / n구간 할 일 / 완료 기준 · 추천 이유(접기) / 나중에 · 승인하기 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bg_mountain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        tools:src="@drawable/bg_mountain_autumn" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#141E322D"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/wrap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingTop="40dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:id="@+id/card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_recovery_pop"
                android:orientation="vertical"
                android:paddingHorizontal="18dp"
                android:paddingTop="18dp"
                android:paddingBottom="14dp">

                <!-- AI · 시뮬레이션 · 닫기 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical|end"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Widget.OREUM.AiTag"
                        android:text="@string/rec_ai_tag" />

                    <ImageButton
                        android:id="@+id/btn_close"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_close_glass"
                        android:contentDescription="@string/close"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_close"
                        app:tint="#3E5650" />
                </LinearLayout>

                <TextView
                    android:id="@+id/text_eyebrow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/oreum_ink3"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    tools:text="프로그래밍 과제 제출" />

                <TextView
                    android:id="@+id/text_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@color/oreum_dark_text"
                    android:textSize="21sp"
                    tools:text="3구간 추천이 준비됐어요" />

                <!-- 추천이 있을 때 -->
                <LinearLayout
                    android:id="@+id/group_plan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- 단계 · 주제 · 할 일 / 예상 시간 -->
                    <LinearLayout
                        android:id="@+id/hero"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical"
                        android:paddingHorizontal="14dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="12dp">

                        <TextView
                            android:id="@+id/text_stage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/oreum_forest_deep"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="2단계 · 기능 구현 / 3단계" />

                        <TextView
                            android:id="@+id/text_topic"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/oreum_dark_text"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            tools:text="데이터 저장 구현" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="12dp"
                            android:background="#1A285041" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center_horizontal"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/text_kpi_items"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/oreum_dark_text"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    tools:text="4개" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="@string/next_kpi_items"
                                    android:textColor="@color/oreum_ink3"
                                    android:textSize="11.5sp" />
                            </LinearLayout>

                            <View
                                android:layout_width="1dp"
                                android:layout_height="match_parent"
                                android:background="#1A285041" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center_horizontal"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/text_kpi_minutes"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/oreum_dark_text"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    tools:text="1시간 35분" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="@string/next_kpi_minutes"
                                    android:textColor="@color/oreum_ink3"
                                    android:textSize="11.5sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- 지난 n구간 한 줄 -->
                    <LinearLayout
                        android:id="@+id/row_last"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="10dp">

                        <TextView
                            android:id="@+id/text_last"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/oreum_ink2"
                            android:textSize="13sp"
                            tools:text="지난 2구간  2/3 완료" />

                        <LinearLayout
                            android:id="@+id/chips_last"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end|center_vertical"
                            android:orientation="horizontal" />
                    </LinearLayout>

                    <!-- 이렇게 바꿨어요 -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:paddingHorizontal="2dp"
                        android:text="@string/next_fixes"
                        android:textColor="@color/oreum_dark_text"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/group_fixes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:chipSpacingHorizontal="6dp"
                        app:chipSpacingVertical="6dp" />

                    <!-- n구간 할 일 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="bottom"
                        android:orientation="horizontal"
                        android:paddingHorizontal="2dp">

                        <TextView
                            android:id="@+id/text_items_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/oreum_dark_text"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            tools:text="3구간 할 일" />

                        <TextView
                            android:id="@+id/text_items_minutes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/oreum_ink3"
                            android:textSize="12.5sp"
                            android:textStyle="bold"
                            tools:text="1시간 35분" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/list_items"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="2dp" />

                    <!-- 완료 기준 · 추천 이유 (접기) -->
                    <LinearLayout
                        android:id="@+id/fold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/btn_fold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="11dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/next_fold"
                                android:textColor="@color/oreum_ink2"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:id="@+id/icon_fold"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:importantForAccessibility="no"
                                android:rotation="-90"
                                android:src="@drawable/ic_expand_more"
                                app:tint="@color/oreum_ink3" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/fold_body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingHorizontal="12dp"
                            android:paddingBottom="12dp"
                            android:visibility="gone"
                            tools:visibility="visible">

                            <TextView
                                style="@style/Widget.OREUM.RecoveryCardTitle"
                                android:layout_marginTop="2dp"
                                android:text="@string/round_review_criteria"
                                android:textSize="12.5sp" />

                            <TextView
                                android:id="@+id/text_criteria"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:lineSpacingMultiplier="1.3"
                                android:textColor="@color/oreum_ink2"
                                android:textSize="12.5sp"
                                tools:text="•  예제 문제 80% 이상 스스로 풀이" />

                            <TextView
                                style="@style/Widget.OREUM.RecoveryCardTitle"
                                android:layout_marginTop="10dp"
                                android:text="@string/next_why"
                                android:textSize="12.5sp" />

                            <TextView
                                android:id="@+id/text_why"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:lineSpacingMultiplier="1.3"
                                android:textColor="@color/oreum_ink2"
                                android:textSize="12.5sp"
                                tools:text="•  2구간 항목 3개 중 2개를 끝냈어요" />

                            <TextView
                                android:id="@+id/text_memo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:textColor="@color/oreum_ink3"
                                android:textSize="12.5sp"
                                tools:text="“조인 응용 문제가 헷갈렸어요”" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:text="@string/next_note"
                        android:textColor="@color/oreum_ink3"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- 로드맵을 모두 마쳤을 때 · 추천이 없을 때 -->
                <TextView
                    android:id="@+id/text_lead"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingMultiplier="1.3"
                    android:textColor="@color/oreum_ink2"
                    android:textSize="14sp"
                    android:visibility="gone"
                    tools:text="데이터베이스 기말고사 로드맵 4단계를 모두 끝냈어요. 더 할 구간이 없어요." />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_later"
                        style="@style/Widget.OREUM.Button.Outline"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingHorizontal="4dp"
                        android:text="@string/next_later" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_approve"
                        style="@style/Widget.OREUM.Button.Primary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1.6"
                        android:minHeight="48dp"
                        android:paddingHorizontal="4dp"
                        android:text="@string/next_approve"
                        android:textSize="14sp"
                        app:icon="@drawable/ic_check"
                        app:iconGravity="textStart"
                        app:iconPadding="4dp"
                        app:iconSize="17dp"
                        app:iconTint="@color/white" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
