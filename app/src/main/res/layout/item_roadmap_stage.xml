<?xml version="1.0" encoding="utf-8"?>
<!-- 로드맵 단계 한 줄: 번호 · 단계 이름 · 예상 시간 (누르면 범위 펼치기) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:paddingVertical="11dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/text_no"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_stage_num"
            android:gravity="center"
            android:textColor="@color/oreum_ink2"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="1" />

        <TextView
            android:id="@+id/text_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/oreum_dark_text"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="소프트웨어 설계" />

        <TextView
            android:id="@+id/text_first"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_badge"
            android:paddingHorizontal="7dp"
            android:paddingVertical="2dp"
            android:text="@string/round_review_first_badge"
            android:textColor="@color/oreum_forest_deep"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/text_hours"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/oreum_ink3"
            android:textSize="12.5sp"
            tools:text="8시간 30분" />
    </LinearLayout>

    <TextView
        android:id="@+id/text_scope"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="34dp"
        android:layout_marginTop="6dp"
        android:lineSpacingMultiplier="1.15"
        android:textColor="@color/oreum_ink2"
        android:textSize="12.5sp"
        android:visibility="gone"
        tools:text="요구사항 분석 · UML · 설계 모델 · 디자인 패턴"
        tools:visibility="visible" />
</LinearLayout>
