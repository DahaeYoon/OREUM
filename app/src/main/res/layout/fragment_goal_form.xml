<?xml version="1.0" encoding="utf-8"?>
<!-- STEP 2 목표 만들기 · 수정 팝업 (프로토타입 새 학습 목표 시트): 6개 항목 -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="22dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_grab" />

        <TextView
            android:id="@+id/text_screen_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/oreum_dark_text"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="@string/study_form_title_new" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/study_form_label_title"
                android:textAppearance="@style/TextAppearance.OREUM.FormLabel" />

            <EditText
                android:id="@+id/input_title"
                style="@style/Widget.OREUM.Input.Glass"
                android:layout_marginTop="6dp"
                android:hint="@string/study_form_hint_title"
                android:imeOptions="actionNext"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLength="40" />

            <TextView
                android:id="@+id/text_title_error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/study_error_title"
                android:textColor="@color/oreum_error"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/study_form_label_desc"
                android:textAppearance="@style/TextAppearance.OREUM.FormLabel" />

            <EditText
                android:id="@+id/input_desc"
                style="@style/Widget.OREUM.Input.Glass"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="top"
                android:hint="@string/study_form_hint_desc"
                android:importantForAutofill="no"
                android:inputType="textMultiLine"
                android:maxLength="200"
                android:minLines="2"
                android:paddingVertical="10dp"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/study_form_label_period"
                android:textAppearance="@style/TextAppearance.OREUM.SectionLabel" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/study_form_start_label"
                        android:textAppearance="@style/TextAppearance.OREUM.FormLabel" />

                    <TextView
                        android:id="@+id/btn_start"
                        style="@style/Widget.OREUM.Input.Glass"
                        android:layout_marginTop="6dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:textSize="14sp"
                        app:drawableEndCompat="@drawable/ic_nav_calendar"
                        app:drawableTint="@color/oreum_dark_text"
                        tools:text="2026.11.12" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/study_form_due_label"
                        android:textAppearance="@style/TextAppearance.OREUM.FormLabel" />

                    <TextView
                        android:id="@+id/btn_due"
                        style="@style/Widget.OREUM.Input.Glass"
                        android:layout_marginTop="6dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:textSize="14sp"
                        app:drawableEndCompat="@drawable/ic_nav_calendar"
                        app:drawableTint="@color/oreum_dark_text"
                        tools:text="2026.11.12" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/study_form_label_level"
                android:textAppearance="@style/TextAppearance.OREUM.SectionLabel" />

            <LinearLayout
                android:id="@+id/seg_level"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_seg_track_glass"
                android:orientation="horizontal"
                android:padding="3dp">

                <TextView
                    android:id="@+id/level_beginner"
                    style="@style/Widget.OREUM.SegItem" />

                <TextView
                    android:id="@+id/level_intermediate"
                    style="@style/Widget.OREUM.SegItem" />

                <TextView
                    android:id="@+id/level_advanced"
                    style="@style/Widget.OREUM.SegItem" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/study_form_label_time"
                android:textAppearance="@style/TextAppearance.OREUM.SectionLabel" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_white_row"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="8dp"
                android:paddingBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/study_form_weekday"
                    android:textColor="@color/oreum_dark_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="122dp"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_stepper"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btn_weekday_minus"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/study_form_minus"
                        android:gravity="center"
                        android:text="−"
                        android:textColor="@color/oreum_dark_text"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/text_weekday"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:maxLines="1"
                        android:textColor="@color/oreum_dark_text"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="2시간" />

                    <TextView
                        android:id="@+id/btn_weekday_plus"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/study_form_plus"
                        android:gravity="center"
                        android:text="+"
                        android:textColor="@color/oreum_dark_text"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_white_row"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="8dp"
                android:paddingBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/study_form_weekend"
                    android:textColor="@color/oreum_dark_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="122dp"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_stepper"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btn_weekend_minus"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/study_form_minus"
                        android:gravity="center"
                        android:text="−"
                        android:textColor="@color/oreum_dark_text"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/text_weekend"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:maxLines="1"
                        android:textColor="@color/oreum_dark_text"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="2시간" />

                    <TextView
                        android:id="@+id/btn_weekend_plus"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/study_form_plus"
                        android:gravity="center"
                        android:text="+"
                        android:textColor="@color/oreum_dark_text"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/study_form_label_priority"
                android:textAppearance="@style/TextAppearance.OREUM.SectionLabel" />

            <LinearLayout
                android:id="@+id/seg_priority"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_seg_track_glass"
                android:orientation="horizontal"
                android:padding="3dp">

                <TextView
                    android:id="@+id/priority_high"
                    style="@style/Widget.OREUM.SegItem" />

                <TextView
                    android:id="@+id/priority_mid"
                    style="@style/Widget.OREUM.SegItem" />

                <TextView
                    android:id="@+id/priority_low"
                    style="@style/Widget.OREUM.SegItem" />

            </LinearLayout>

            <TextView
                android:id="@+id/text_form_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/oreum_error"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="@string/study_error_period"
                tools:visibility="visible" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_cancel"
                    style="@style/Widget.OREUM.Button.SheetOutline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/study_form_cancel" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_save"
                    style="@style/Widget.OREUM.Button.SheetPrimary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1.4"
                    tools:text="@string/study_form_save_new" />
            </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
