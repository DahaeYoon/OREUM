<?xml version="1.0" encoding="utf-8"?>
<!-- 목표 상세 (계획 탭을 대신): 이번 구간 · 다음 구간 추천 · 마감 한 줄 · 전체 로드맵 · 이전 구간 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bg_mountain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        tools:src="@drawable/bg_mountain_autumn" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#59FFFFFF" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <!-- 뒤로 · 목표 상세 · 수정 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btn_back"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="-10dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/back"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/oreum_dark_text" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/goal_detail_title"
                    android:textAppearance="@style/TextAppearance.OREUM.ScreenTitle"
                    android:textSize="17sp" />

                <ImageButton
                    android:id="@+id/btn_edit"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="-10dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/goal_detail_edit"
                    android:padding="11dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_edit"
                    app:tint="@color/oreum_ink2" />
            </LinearLayout>

            <TextView
                android:id="@+id/text_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:breakStrategy="balanced"
                android:textColor="@color/oreum_dark_text"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="데이터베이스 기말고사" />

            <TextView
                android:id="@+id/text_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/oreum_ink3"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="데이터베이스 · 마감 11/7 · D-2" />

            <!-- 로드맵 없음 · 승인 대기 · 다음 구간 추천 도착 -->
            <LinearLayout
                android:id="@+id/card_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_ai_tag"
                    android:paddingHorizontal="9dp"
                    android:paddingVertical="2dp"
                    android:text="@string/ai_tag_simulation"
                    android:textColor="@color/oreum_brand_blue"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/text_state_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/oreum_dark_text"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="AI 다음 구간 추천이 도착했어요" />

                <TextView
                    android:id="@+id/text_state_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/oreum_ink2"
                    android:textSize="13sp"
                    tools:text="3구간 · 데이터 저장 구현 · 항목 4개" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_state"
                    style="@style/Widget.OREUM.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    tools:text="추천 확인" />
            </LinearLayout>

            <!-- 이번 구간 -->
            <LinearLayout
                android:id="@+id/card_round"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="14dp"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/text_round_no"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_stage_num_cur_pill"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:textColor="@android:color/white"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        tools:text="4구간" />

                    <TextView
                        android:id="@+id/text_round_topic"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/oreum_dark_text"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="BCNF와 반정규화" />

                    <TextView
                        android:id="@+id/text_round_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_badge"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:textColor="@color/oreum_forest_deep"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        tools:text="진행 중" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progress_round"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="100"
                        app:indicatorColor="@color/oreum_forest_mint"
                        app:trackColor="#1A3E8E7A"
                        app:trackCornerRadius="3dp"
                        app:trackStopIndicatorSize="0dp"
                        app:trackThickness="6dp"
                        tools:progress="25" />

                    <TextView
                        android:id="@+id/text_round_sum"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:textColor="@color/oreum_ink3"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="1/4 · 1시간 50분" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/item_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:divider="@drawable/divider_row"
                    android:orientation="vertical"
                    android:showDividers="middle" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_round_add"
                        style="@style/Widget.OREUM.Button.Outline"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingHorizontal="4dp"
                        android:text="@string/round_review_add_item"
                        app:icon="@drawable/ic_add"
                        app:iconGravity="textStart"
                        app:iconPadding="4dp"
                        app:iconSize="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_round_main"
                        style="@style/Widget.OREUM.Button.Primary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1.3"
                        android:paddingHorizontal="4dp"
                        android:visibility="gone"
                        tools:text="4구간 시작"
                        tools:visibility="visible" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_fold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_fold_row"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="11dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/round_review_fold"
                        android:textColor="@color/oreum_ink2"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/icon_fold"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_expand_more"
                        app:tint="@color/oreum_ink3" />
                </LinearLayout>

                <TextView
                    android:id="@+id/text_fold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingMultiplier="1.25"
                    android:paddingHorizontal="4dp"
                    android:textColor="@color/oreum_ink2"
                    android:textSize="12.5sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 마감 위험 한 줄 -->
            <LinearLayout
                android:id="@+id/row_due"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_warn"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="11dp"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_alert"
                    app:tint="@color/oreum_coral_ink" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/text_due_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/oreum_coral_ink"
                        android:textSize="13.5sp"
                        android:textStyle="bold"
                        tools:text="마감까지 어려울 수 있어요" />

                    <TextView
                        android:id="@+id/text_due_body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/oreum_ink2"
                        android:textSize="12.5sp"
                        tools:text="남은 학습 8시간 15분 · 3일 남음" />
                </LinearLayout>
            </LinearLayout>

            <!-- 전체 로드맵 -->
            <LinearLayout
                android:id="@+id/group_roadmap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="bottom"
                    android:orientation="horizontal"
                    android:paddingHorizontal="2dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/round_review_roadmap"
                        android:textColor="@color/oreum_dark_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/text_roadmap_percent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/oreum_ink3"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="39%" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/stage_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_glass_card"
                    android:divider="@drawable/divider_row"
                    android:orientation="vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="4dp"
                    android:showDividers="middle" />
            </LinearLayout>

            <!-- 이전 구간 -->
            <LinearLayout
                android:id="@+id/group_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="bottom"
                    android:orientation="horizontal"
                    android:paddingHorizontal="2dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/goal_detail_history"
                        android:textColor="@color/oreum_dark_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/text_history_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/oreum_ink3"
                        android:textSize="12sp"
                        tools:text="3개" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/history_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_glass_card"
                    android:divider="@drawable/divider_row"
                    android:orientation="vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="2dp"
                    android:showDividers="middle" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_delete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:background="?attr/selectableItemBackground"
                android:padding="10dp"
                android:text="@string/goal_detail_delete"
                android:textColor="@color/oreum_ink3"
                android:textSize="13sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
