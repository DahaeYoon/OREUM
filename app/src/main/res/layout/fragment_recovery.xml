<?xml version="1.0" encoding="utf-8"?>
<!-- STEP 5 AI 학습 계획 복구 (프로토타입 r5): 산 배경 위 유리 팝업 · 원인 · 이렇게 바꿀게요 · 바뀌는 계획 · 취소 / 복구 승인 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bg_mountain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        tools:src="@drawable/bg_mountain_autumn" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#141E322D"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/wrap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingTop="56dp"
            android:paddingBottom="28dp">

            <!-- 유리 팝업 (배경은 코드에서 흐린 산 + 흰 60%) -->
            <LinearLayout
                android:id="@+id/card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_recovery_pop"
                android:orientation="vertical"
                android:paddingHorizontal="18dp"
                android:paddingTop="18dp"
                android:paddingBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical|end"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/text_ai_tag"
                        style="@style/Widget.OREUM.AiTag"
                        android:text="@string/rec_ai_tag" />

                    <ImageButton
                        android:id="@+id/btn_close"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_close_glass"
                        android:contentDescription="@string/close"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_close"
                        app:tint="#3E5650" />
                </LinearLayout>

                <TextView
                    android:id="@+id/text_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/rec_title"
                    android:textColor="#1F2D2A"
                    android:textSize="20sp" />

                <!-- 복구할 항목이 있을 때 -->
                <LinearLayout
                    android:id="@+id/group_plan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/text_lead"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/oreum_ink2"
                        android:textSize="13sp"
                        tools:text="계획 3시간 30분 중 2시간 수행 · 남은 분량 1시간 30분" />

                    <!-- 원인 -->
                    <LinearLayout
                        style="@style/Widget.OREUM.RecoveryCard"
                        android:layout_marginTop="12dp">

                        <TextView
                            style="@style/Widget.OREUM.RecoveryCardTitle"
                            android:text="@string/rec_cause" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chips_cause"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            app:chipSpacingHorizontal="4dp"
                            app:chipSpacingVertical="4dp" />

                        <TextView
                            android:id="@+id/text_memo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textColor="@color/oreum_ink2"
                            android:textSize="12sp"
                            tools:text="“락 부분이 헷갈렸어요”" />

                        <LinearLayout
                            android:id="@+id/list_why"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="vertical" />

                        <TextView
                            android:id="@+id/text_recent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textColor="@color/oreum_ink3"
                            android:textSize="11.5sp"
                            tools:text="최근 3일 평균 달성률 57%" />
                    </LinearLayout>

                    <!-- 이렇게 바꿀게요 -->
                    <LinearLayout
                        style="@style/Widget.OREUM.RecoveryCard"
                        android:layout_marginTop="10dp">

                        <TextView
                            style="@style/Widget.OREUM.RecoveryCardTitle"
                            android:text="@string/rec_fix" />

                        <LinearLayout
                            android:id="@+id/list_fix"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="vertical" />

                        <TextView
                            android:id="@+id/btn_more"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="?attr/selectableItemBackground"
                            android:drawablePadding="4dp"
                            android:gravity="center_vertical"
                            android:text="@string/rec_more"
                            android:textColor="#3E7F86"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:drawableStartCompat="@drawable/ic_spark_13"
                            app:drawableTint="#3E7F86" />

                        <LinearLayout
                            android:id="@+id/row_extra"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <EditText
                                android:id="@+id/input_extra"
                                style="@style/Widget.OREUM.Input.Glass"
                                android:layout_width="0dp"
                                android:layout_height="38dp"
                                android:layout_weight="1"
                                android:hint="@string/rec_extra_hint"
                                android:imeOptions="actionDone"
                                android:importantForAutofill="no"
                                android:inputType="text"
                                android:paddingHorizontal="10dp"
                                android:textSize="12.5sp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_reanalyze"
                                style="@style/Widget.OREUM.Button.SheetOutline"
                                android:layout_width="wrap_content"
                                android:layout_height="38dp"
                                android:layout_marginStart="6dp"
                                android:minHeight="38dp"
                                android:minWidth="0dp"
                                android:paddingHorizontal="10dp"
                                android:text="@string/rec_reanalyze"
                                android:textSize="12.5sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- 바뀌는 계획 -->
                    <LinearLayout
                        style="@style/Widget.OREUM.RecoveryCard"
                        android:layout_marginTop="10dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/Widget.OREUM.RecoveryCardTitle"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:text="@string/rec_changes" />

                            <TextView
                                android:id="@+id/btn_compare"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="?attr/selectableItemBackground"
                                android:text="@string/rec_compare_full"
                                android:textColor="@color/oreum_ink3"
                                android:textSize="11.5sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/list_days"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="vertical" />
                    </LinearLayout>

                    <!-- 마감 안에 다 넣을 수 없을 때 -->
                    <LinearLayout
                        android:id="@+id/box_unplaced"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_rec_warn"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="10dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginTop="2dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_alert"
                            app:tint="#A9634C" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/text_unplaced"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="#A9634C"
                                android:textSize="12.5sp"
                                android:textStyle="bold"
                                tools:text="마감 안에 다 넣을 수 없어요 (3시간 30분 부족)" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/rec_unplaced_body"
                                android:textColor="#A9634C"
                                android:textSize="12.5sp" />

                            <TextView
                                android:id="@+id/btn_adjust_goal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:background="?attr/selectableItemBackground"
                                android:text="@string/rec_adjust_goal"
                                android:textColor="#A9634C"
                                android:textSize="12.5sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:gravity="center"
                        android:text="@string/rec_note"
                        android:textColor="@color/oreum_sub_text"
                        android:textSize="11.5sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_cancel"
                            style="@style/Widget.OREUM.Button.SheetOutline"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:text="@string/rec_cancel"
                            app:backgroundTint="#8CFFFFFF"
                            app:strokeColor="#E6FFFFFF" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_approve"
                            style="@style/Widget.OREUM.Button.SheetPrimary"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1.6"
                            android:text="@string/rec_approve"
                            app:icon="@drawable/ic_check"
                            app:iconGravity="textStart"
                            app:iconPadding="4dp"
                            app:iconSize="17dp"
                            app:iconTint="@color/white" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 복구할 항목이 없을 때 -->
                <LinearLayout
                    android:id="@+id/group_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="8dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_rec_ok"
                        android:importantForAccessibility="no"
                        android:padding="13dp"
                        android:src="@drawable/ic_check"
                        app:tint="@color/oreum_today_green" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="sans-serif-black"
                        android:text="@string/rec_empty_title"
                        android:textColor="#1F2D2A"
                        android:textSize="17sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="@string/rec_empty_body"
                        android:textColor="@color/oreum_ink2"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_empty_ok"
                        style="@style/Widget.OREUM.Button.SheetPrimary"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="16dp"
                        android:text="@string/rec_empty_ok" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
