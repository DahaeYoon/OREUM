<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="78dp"
    android:background="@drawable/bg_home_next_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingVertical="8dp"
    android:paddingEnd="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_next_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="#3E8E7A"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="오늘 다음 학습" />

        <TextView
            android:id="@+id/text_next_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/oreum_dark_text"
            android:textSize="14.5sp"
            android:textStyle="bold"
            tools:text="동시성 제어 · 락 정리" />

        <TextView
            android:id="@+id/text_next_cap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/oreum_ink2"
            android:textSize="12sp"
            tools:text="데이터베이스 기말고사 · 2시간" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_next"
        style="@style/Widget.OREUM.Button.SheetPrimary"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginStart="10dp"
        android:minWidth="0dp"
        android:minHeight="36dp"
        android:paddingHorizontal="12dp"
        android:textSize="13sp"
        app:iconPadding="4dp"
        app:iconSize="17dp"
        app:iconTint="@color/white"
        tools:icon="@drawable/ic_check"
        tools:text="완료" />
</LinearLayout>
