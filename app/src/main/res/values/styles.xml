<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 반투명 입력칸 (로그인 · 회원가입 · 이후 모든 입력 화면 공용) -->
    <style name="Widget.OREUM.TextInput.Glass" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="hintEnabled">false</item>
        <item name="boxBackgroundColor">#8CFFFFFF</item>
        <item name="boxStrokeColor">@color/field_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="startIconTint">@color/oreum_sub_text</item>
        <item name="endIconTint">@color/oreum_sub_text</item>
        <item name="errorTextColor">@color/oreum_error</item>
        <item name="boxStrokeErrorColor">@color/oreum_error</item>
        <item name="errorIconDrawable">@null</item>
        <item name="helperTextTextColor">@color/oreum_sub_text</item>
    </style>

    <style name="Widget.OREUM.EditText.Glass" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/oreum_dark_text</item>
        <item name="android:textColorHint">#8A5E716C</item>
        <item name="android:minHeight">54dp</item>
    </style>

    <!-- 진한 숲색 주 버튼 -->
    <style name="Widget.OREUM.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">54dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/oreum_deep_button</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <!-- 글자만 있는 링크 버튼 -->
    <style name="Widget.OREUM.Button.Link" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/oreum_dark_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>

    <!-- 글자 크기 -->
    <style name="TextAppearance.OREUM.Brand" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/oreum_brand_blue</item>
    </style>

    <style name="TextAppearance.OREUM.Display" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/oreum_dark_text</item>
    </style>
</resources>
