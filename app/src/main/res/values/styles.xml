<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 반투명 입력칸 (로그인 · 회원가입 · 이후 모든 입력 화면 공용) -->
    <style name="Widget.OREUM.TextInput.Glass" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="hintEnabled">false</item>
        <item name="boxBackgroundColor">#8CFFFFFF</item>
        <item name="boxStrokeColor">@color/field_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="startIconTint">@color/oreum_sub_text</item>
        <item name="endIconTint">@color/oreum_sub_text</item>
        <item name="errorTextColor">@color/oreum_error</item>
        <item name="boxStrokeErrorColor">@color/oreum_error</item>
        <item name="errorIconDrawable">@null</item>
        <item name="helperTextTextColor">@color/oreum_sub_text</item>
    </style>

    <style name="Widget.OREUM.EditText.Glass" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/oreum_dark_text</item>
        <item name="android:textColorHint">#8A5E716C</item>
        <item name="android:minHeight">54dp</item>
    </style>

    <!-- 진한 숲색 주 버튼 -->
    <style name="Widget.OREUM.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">54dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/oreum_deep_button</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <!-- 글자만 있는 링크 버튼 -->
    <style name="Widget.OREUM.Button.Link" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/oreum_dark_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>

    <!-- 세그먼트 한 칸: 회색(또는 반투명) 칸 안에서 고른 칸만 흰색 (프로토타입 .seg) -->
    <style name="Widget.OREUM.SegItem" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/seg_item_bg</item>
        <item name="android:textColor">@color/seg_item_text</item>
    </style>

    <!-- 글자 탭 (전체 · 일일 · 주간 · 월간): 고르면 진한 글자 + 밑줄 (프로토타입 .g4-pd) -->
    <style name="Widget.OREUM.TabItem" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">14dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/tab_item_bg</item>
        <item name="android:textColor">@color/tab_item_text</item>
    </style>

    <!-- 주 · 월 전환 칸 -->
    <style name="Widget.OREUM.ToggleItem" parent="">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">12.5sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/toggle_item_bg</item>
        <item name="android:textColor">@color/tab_item_text</item>
    </style>

    <!-- 못 끝낸 이유 칩 (프로토타입 .chip-select) -->
    <style name="Widget.OREUM.ReasonChip" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">26dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/chip_reason_bg</item>
        <item name="android:textColor">@color/chip_reason_text</item>
    </style>

    <!-- 회고 키워드 칩 (프로토타입 .lg-k) -->
    <style name="Widget.OREUM.TagChip" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:textSize">11.5sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/chip_tag_bg</item>
        <item name="android:textColor">@color/chip_tag_text</item>
    </style>

    <!-- 반투명 입력칸 (팝업 안 · 프로토타입 .input) -->
    <style name="Widget.OREUM.Input.Glass" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/bg_input_glass</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/oreum_dark_text</item>
        <item name="android:textColorHint">@color/oreum_ink3</item>
    </style>

    <!-- 팝업 버튼 (높이 40 · 모서리 12) -->
    <style name="Widget.OREUM.Button.SheetPrimary" parent="Widget.Material3.Button">
        <item name="android:minHeight">40dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/oreum_dark_text</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="Widget.OREUM.Button.SheetOutline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">40dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/oreum_dark_text</item>
        <item name="backgroundTint">#80FFFFFF</item>
        <item name="strokeColor">#E6FFFFFF</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="Widget.OREUM.Button.SheetText" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">34dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/oreum_forest_deep</item>
        <item name="iconTint">@color/oreum_forest_deep</item>
        <item name="iconSize">15dp</item>
        <item name="iconPadding">4dp</item>
    </style>

    <!-- 테두리 버튼 (취소 · 수정 등 보조 동작) -->
    <style name="Widget.OREUM.Button.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/oreum_dark_text</item>
        <item name="backgroundTint">#99FFFFFF</item>
        <item name="strokeColor">@color/oreum_divider</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <!-- 작은 주 버튼 (새 목표 등) -->
    <style name="Widget.OREUM.Button.Small" parent="Widget.Material3.Button">
        <item name="android:minHeight">38dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/oreum_deep_button</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <!-- 글자 크기 -->
    <style name="TextAppearance.OREUM.Brand" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/oreum_brand_blue</item>
    </style>

    <style name="TextAppearance.OREUM.Display" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/oreum_dark_text</item>
    </style>

    <!-- 화면 제목 (목표 · 계획 · 기록 · 마이 상단 바, 프로토타입 18px) -->
    <style name="TextAppearance.OREUM.ScreenTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/oreum_dark_text</item>
    </style>

    <!-- 입력 화면의 구역 이름 (예: 3. 기간 · 프로토타입 .t-label) -->
    <style name="TextAppearance.OREUM.SectionLabel" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">12.5sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/oreum_ink2</item>
    </style>

    <!-- 입력 화면의 항목 이름 (예: 1. 목표 이름) -->
    <style name="TextAppearance.OREUM.FormLabel" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/oreum_dark_text</item>
    </style>

    <!-- 보조 설명 글씨 -->
    <style name="TextAppearance.OREUM.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/oreum_sub_text</item>
    </style>
    <!-- AI 학습 계획 복구 (프로토타입 r5) -->
    <style name="Widget.OREUM.AiTag" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:background">@drawable/bg_ai_tag_pill</item>
        <item name="android:textColor">#3E7F86</item>
        <item name="android:textSize">10.5sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="Widget.OREUM.RecoveryCard" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_rec_card</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="Widget.OREUM.RecoveryCardTitle" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/oreum_dark_text</item>
        <item name="android:textSize">13.5sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <!-- 기록 (STEP 6) -->
    <style name="Widget.OREUM.FilterChip" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">11dp</item>
        <item name="android:paddingEnd">11dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:textSize">12.5sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/filter_chip_bg</item>
        <item name="android:textColor">@color/filter_chip_text</item>
    </style>

    <style name="Widget.OREUM.RecordsKpi" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_records_kpi</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">9dp</item>
        <item name="android:paddingBottom">9dp</item>
    </style>

    <style name="Widget.OREUM.RecordsKpiLabel" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textSize">10.5sp</item>
        <item name="android:textColor">@color/oreum_ink2</item>
    </style>

    <style name="Widget.OREUM.RecordsKpiValue" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/oreum_dark_text</item>
    </style>

    <style name="Widget.OREUM.RecordsCard" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_records_card</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="Widget.OREUM.RecordsCardTitle" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxLines">1</item>
        <item name="android:textSize">13.5sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/oreum_dark_text</item>
    </style>

    <style name="Widget.OREUM.RecordsLegend" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/oreum_ink2</item>
    </style>

    <style name="Widget.OREUM.RecordsBody" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
        <item name="android:textColor">@color/oreum_dark_text</item>
    </style>
    <!-- 홈 (STEP 7) -->
    <style name="Widget.OREUM.HomeIndItem" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">24dp</item>
        <item name="android:paddingStart">7dp</item>
        <item name="android:paddingEnd">7dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/home_ind_item_bg</item>
        <item name="android:textColor">@color/home_ind_item_text</item>
    </style>

    <style name="Widget.OREUM.HomeStat" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_home_stat</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="Widget.OREUM.HomeStatValue" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxLines">1</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">#3E8E7A</item>
    </style>

    <style name="Widget.OREUM.HomeStatLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">1dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/oreum_ink2</item>
    </style>
</resources>
