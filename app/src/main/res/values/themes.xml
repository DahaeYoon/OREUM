<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- 오름 기본 테마: 프로토타입처럼 밝은 크림 배경 + 민트 계열 -->
    <style name="Base.Theme.OREUM" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/oreum_forest_mint</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/oreum_mint</item>
        <item name="colorOnPrimaryContainer">@color/oreum_dark_text</item>
        <item name="colorSecondary">@color/oreum_sky_blue</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorTertiary">@color/oreum_yellow_accent</item>
        <item name="android:colorBackground">@color/oreum_cream_white</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/oreum_dark_text</item>
        <item name="colorOnBackground">@color/oreum_dark_text</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.OREUM" parent="Base.Theme.OREUM" />

    <!-- 아래에서 올라오는 반투명 팝업 (프로토타입 .glass-sheet)
         창 배경은 완전히 투명하고, 팝업 내용에만 유리 배경(GlassBackgroundDrawable)을 깔아요.
         뒤 화면은 프로토타입처럼 12%만 어둡게 해요. -->
    <style name="ThemeOverlay.OREUM.GlassSheet" parent="ThemeOverlay.Material3.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.12</item>
        <item name="android:windowAnimationStyle">@style/Animation.OREUM.GlassSheet</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

    <style name="Animation.OREUM.GlassSheet" parent="">
        <item name="android:windowEnterAnimation">@anim/sheet_in</item>
        <item name="android:windowExitAnimation">@anim/sheet_out</item>
    </style>

    <!-- 하단 내비게이션 -->
    <style name="Widget.OREUM.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/white</item>
        <item name="elevation">0dp</item>
        <item name="android:elevation">0dp</item>
        <item name="itemIconTint">@color/bottom_nav_item</item>
        <item name="itemTextColor">@color/bottom_nav_item</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.OREUM.BottomNav.Indicator</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <style name="Widget.OREUM.BottomNav.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">#E3F1EC</item>
    </style>
</resources>
